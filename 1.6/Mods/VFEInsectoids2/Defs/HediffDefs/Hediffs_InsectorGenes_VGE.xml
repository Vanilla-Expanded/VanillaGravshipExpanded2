<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>VGE_Floating_Space</defName>
		<label>microgravity adapted</label>
		<description>While in space, this person moves with enhanced agility, works with greater efficiency, and effortlessly glides across the vacuum of space.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<scenarioCanAdd>false</scenarioCanAdd>
		<allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
		<maxSeverity>1.0</maxSeverity>
		<isBad>false</isBad>
		<comps>
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_Floating">
				<inSpace>true</inSpace>
			</li>
		</comps>
	</HediffDef>
	<HediffDef>
		<defName>VGE_FloatingOrgans</defName>
		<label>floating organs</label>
		<description>This person lacks the internal connective tissues that normally hold organs in place under planetary gravity. Subjecting them to standard gravity causes their internal organs to shift and sag painfully, resulting in chronic nausea and persistent lethargy.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<scenarioCanAdd>false</scenarioCanAdd>
		<allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
		<maxSeverity>1.0</maxSeverity>
		<isBad>false</isBad>
		<comps>
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_StageByVacuum">
			</li>
		</comps>
		<stages>
			<li>
				<minSeverity>0.1</minSeverity>
				<vomitMtbDays>1.5</vomitMtbDays>
				<statOffsets>
					<MoveSpeed>-0.6</MoveSpeed>
				</statOffsets>
				<capMods>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.15</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>1</minSeverity>
			</li>
		</stages>
	</HediffDef>
	
	<HediffDef>
		<defName>VGE_AstrofuelProduction</defName>
		<label>astrofuel production</label>
		<description>This person has developed volatile astrofuel sacks resembling a tail, drastically increasing their susceptibility to flame damage. If engulfed in large enough flames or upon death, they erupt in a devastating astrofire explosion. Additionally, these sacks can be "milked" periodically to yield valuable astrofuel.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<scenarioCanAdd>false</scenarioCanAdd>
		<maxSeverity>1.0</maxSeverity>
		<allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
		<isBad>false</isBad>
		<comps>
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_Spawner">
				<thingToSpawn>VGE_Astrofuel</thingToSpawn>
				<spawnCount>20</spawnCount>
				<spawnIntervalRange>600000~600000</spawnIntervalRange>
				<spawnMaxAdjacent>30</spawnMaxAdjacent>
				<spawnForbidden>false</spawnForbidden>
				<showMessageIfOwned>false</showMessageIfOwned>
				
			</li>
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_Exploder">
				<explosionForce>4.9</explosionForce>
				<damageDef>VGE_AstrofireDamage</damageDef>
			</li>
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_ExplodeOnFire">
				<minFireToExplode>0.35</minFireToExplode>
				<damageType>VGE_AstrofireDamage</damageType>
				<radius>4.9</radius>
				<ticksToRecheck>60000</ticksToRecheck>
				<checkInterval>30</checkInterval>
			</li>
		</comps>
	</HediffDef>
</Defs>