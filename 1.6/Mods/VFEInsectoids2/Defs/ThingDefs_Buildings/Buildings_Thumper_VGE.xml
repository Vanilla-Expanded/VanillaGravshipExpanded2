<Defs>
	<ThingDef ParentName="VFEI2_ThumperBase">
		<defName>VFEI2_Thumper_Nullipede</defName>
		<label>nullipede thumper</label>
		<description> A vibration-producing thumper device. When activated, it starts emitting powerful thump pulses, which will attract an exoinsectoid nullipede meteor attack with its escorts. If you can defeat it, you can collect a special pherocore from its corpse. The thumps destabilise the thumper, so this building can only be used once. Since it attracts an exoinsectoid attack, it can only be used in orbit.</description>
		<graphicData>
			<texPath>Mods/NullipedeThumper/NullipedeThumper_Base</texPath>
		</graphicData>
		<uiIconPath>Mods/NullipedeThumper/NullipedeThumper_MenuIcon</uiIconPath>
		<costList>
			<Steel>70</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<researchPrerequisites>
			<li>VFEI2_StandardHivetech</li>
			<li>Electricity</li>
		</researchPrerequisites>
		<comps>
