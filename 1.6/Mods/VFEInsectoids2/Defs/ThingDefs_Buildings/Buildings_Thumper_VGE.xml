				<topGraphic>
					<texPath>Mods/NullipedeThumper/NullipedeThumper_Top</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(2,2)</drawSize>
				</topGraphic>
				<needsOrbit>true</needsOrbit>
				<wave>VFEI2_Thumper_Nullipede</wave>
			</li>
			<li Class="VanillaGravshipExpanded2.CompProperties_NullipedeThumper"/>
		</comps>
