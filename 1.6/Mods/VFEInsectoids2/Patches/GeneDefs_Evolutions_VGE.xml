<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Races Expanded - Insector</li>
		</mods>
		<match Class="PatchOperationAdd">
			<xpath>/Defs</xpath>
			<value>
				<VanillaRacesExpandedInsector.GenelineGeneDef ParentName="VRE_EvolutionGene">
					<defName>VGE_Gene_SealedExoskeleton</defName>
					<label>sealed exoskeleton</label>
					<description>Carriers of this gene develop a hermetically sealed exoskeleton capable of internalizing atmospheric pressure and regulating core body heat. This adaptation grants them complete immunity to the vacuum of space and allows them to endure extreme freezing environments without discomfort.</description>
					<selectionWeight>0</selectionWeight>
					<unlockable>true</unlockable>
					<iconPath>Mods/Genes/Gene_SealedExoskeleton</iconPath>
					<displayOrderInCategory>3001</displayOrderInCategory>
					<immuneToVacuumBurns>true</immuneToVacuumBurns>
					<statOffsets>
						<VacuumResistance>1</VacuumResistance>
						<ComfyTemperatureMin>-85</ComfyTemperatureMin>
					</statOffsets>
					<symbolPack>
						<prefixSymbols>
							<li>
								<symbol>void</symbol>
							</li>
							<li>
								<symbol>exo</symbol>
							</li>
							<li>
								<symbol>astro</symbol>
							</li>
							<li>
								<symbol>space</symbol>
							</li>
							<li>
								<symbol>cold</symbol>
							</li>
						</prefixSymbols>
					</symbolPack>
					<exclusionTags>
						<li>MinTemperature</li>
					</exclusionTags>
					<modExtensions>
						<li Class="VEF.Genes.GeneExtension">
							<backgroundPathEndogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathEndogenes>
							<backgroundPathXenogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathXenogenes>
						</li>
					</modExtensions>
				</VanillaRacesExpandedInsector.GenelineGeneDef>
				<VanillaRacesExpandedInsector.GenelineGeneDef ParentName="VRE_EvolutionGene">
					<defName>VGE_Gene_MicrogravityAdapted</defName>
					<label>microgravity adapted</label>
					<description>Carriers of this gene possess musculature and spatial awareness uniquely adapted for zero-gravity environments. While in space, they move with enhanced agility, work with greater efficiency, and effortlessly glide across the vacuum of space.</description>
					<iconPath>Mods/Genes/Gene_MicrogravityAdapted</iconPath>
					<displayOrderInCategory>3002</displayOrderInCategory>
					<unlockable>true</unlockable>
					<symbolPack>
						<prefixSymbols>
							<li>
								<symbol>grav</symbol>
							</li>
							<li>
								<symbol>zero</symbol>
							</li>
							<li>
								<symbol>float</symbol>
							</li>
							<li>
								<symbol>astro</symbol>
							</li>
						</prefixSymbols>
					</symbolPack>
					<conditionalStatAffecters>
						<li Class="VEF.Genes.ConditionalStatAffecter_InSpace">
							<statOffsets>
								<WorkSpeedGlobal>0.1</WorkSpeedGlobal>
								<MoveSpeed>0.4</MoveSpeed>
							</statOffsets>
						</li>
					</conditionalStatAffecters>
					<exclusionTags>
						<li>InsectorMouth</li>
					</exclusionTags>
					<modExtensions>
						<li Class="VEF.Genes.GeneExtension">
							<backgroundPathEndogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathEndogenes>
							<backgroundPathXenogenes>UI/Icons/Genes/VRE_EvolutionBG</backgroundPathXenogenes>
							<hediffToWholeBody>VGE_Floating_Space</hediffToWholeBody>
						</li>
					</modExtensions>
				</VanillaRacesExpandedInsector.GenelineGeneDef>
			</value>
		</match>
	</Operation>
</Patch>

