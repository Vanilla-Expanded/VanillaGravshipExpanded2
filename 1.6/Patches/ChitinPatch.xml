<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Insectoids 2</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VGE_Exopede"]/statBases/LeatherAmount</xpath>
					<value>
						<LeatherAmount>10</LeatherAmount>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VGE_Exopede"]/race</xpath>
					<value>
						<leatherDef>VFEI2_Chitin</leatherDef>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VGE_Exoleech"]/statBases/LeatherAmount</xpath>
					<value>
						<LeatherAmount>10</LeatherAmount>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VGE_Exoleech"]/race</xpath>
					<value>
						<leatherDef>VFEI2_Chitin</leatherDef>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
