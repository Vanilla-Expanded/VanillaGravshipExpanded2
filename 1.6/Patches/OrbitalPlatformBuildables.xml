<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TerrainDef[defName="OrbitalPlatform"]</xpath>
    <value>
		<affordances>
		      <li>VGE_SubstructureAndOrbitalPlatform</li>
		</affordances>
    </value>
  </Operation>

    <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TerrainDef[defName="Substructure"]</xpath>
    <value>
		<affordances>
		      <li>VGE_SubstructureAndOrbitalPlatform</li>
		</affordances>
    </value>
  </Operation>

      <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TerrainDef[defName="VGE_DamagedSubstructure"]</xpath>
    <value>
		<affordances>
		      <li>VGE_SubstructureAndOrbitalPlatform</li>
		</affordances>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VGE_CrewBunkBed" or defName="VGE_MedbayBed" or defName="VGE_CrewLockers" or defName="VGE_GravshipShelf"]/terrainAffordanceNeeded</xpath>
    <value>
      <terrainAffordanceNeeded>VGE_SubstructureAndOrbitalPlatform</terrainAffordanceNeeded>
    </value>
  </Operation>
</Patch>