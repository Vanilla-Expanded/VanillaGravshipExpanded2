<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="VGE_MechStructureBase"]</xpath>
        <value>
            <designationCategory>VGE_Designer</designationCategory>
            <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="MechPylon" or defName="MechanoidDropPod" or defName="MechanoidProcessor" or defName="MechhiveAssembler"]</xpath>
        <value>
		    <designationCategory>VGE_Designer</designationCategory>
		</value>
    </Operation>
</Patch>
