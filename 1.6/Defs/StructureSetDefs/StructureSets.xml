<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <VEF.Storyteller.StructureSetDef>
    <defName>VGE_WarplatformSet</defName>
    <structureLayouts>
      <li>
        <pattern>VGE2_BombardmentPlatform_Wing_[0-9]+</pattern>
        <radialCount>4</radialCount>
        <radialDistance>15</radialDistance>
        <faceCenter>true</faceCenter>
      </li>
      <li>
        <pattern>VGE2_BombardmentPlatform_Warcomputer_[0-9]+</pattern>
        <spawnPawns>
          <Drone_Sentry>6~10</Drone_Sentry>
        </spawnPawns>
      </li>
    </structureLayouts>
  </VEF.Storyteller.StructureSetDef>

  <VEF.Storyteller.StructureSetDef>
    <defName>VGE_GravshipHuskSet</defName>
    <structureLayouts>
      <li>
        <pattern>VGE2_GravshipHuskLarge_[0-9]+</pattern>
        <count>2</count>
        <scatter>true</scatter>
        <randomRotated>true</randomRotated>
      </li>
      <li>
        <pattern>VGE2_GravshipHusk(?:Large|Small)_[0-9]+</pattern>
        <count>4</count>
        <scatter>true</scatter>
        <randomRotated>true</randomRotated>
      </li>
    </structureLayouts>
  </VEF.Storyteller.StructureSetDef>

  <VEF.Storyteller.StructureSetDef>
    <defName>VGE_DerelictGravshipSet</defName>
    <structureLayouts>
      <li>
        <pattern>VGE2_DerelictGravship_Variant_[0-9]+</pattern>
        <randomRotated>true</randomRotated>
      </li>
    </structureLayouts>
  </VEF.Storyteller.StructureSetDef>

  <VEF.Storyteller.StructureSetDef>
    <defName>VGE_GravshipGraveyardSet</defName>
    <structureLayouts>
      <li>
        <pattern>VGE2_DerelictGravship_Jammer_Variant_[0-9]+</pattern>
        <count>1</count>
        <scatter>true</scatter>
        <randomRotated>true</randomRotated>
        <putAnywhere>true</putAnywhere>
      </li>
      <li>
        <pattern>VGE2_DerelictGravship_Variant_[0-9]+</pattern>
        <count>2</count>
        <scatter>true</scatter>
        <randomRotated>true</randomRotated>
      </li>
      <li>
        <pattern>VGE2_GravshipHuskLarge_[0-9]+</pattern>
        <count>10</count>
        <scatter>true</scatter>
        <randomRotated>true</randomRotated>
      </li>
      <li>
        <pattern>VGE2_GravshipHuskSmall_[0-9]+</pattern>
        <count>10~16</count>
        <scatter>true</scatter>
        <randomRotated>true</randomRotated>
      </li>
    </structureLayouts>
  </VEF.Storyteller.StructureSetDef>

  <VEF.Storyteller.StructureSetDef>
    <defName>VGE_TradingGuildStationSet</defName>
    <structureLayouts>
      <li>
        <pattern>TradingGuild_OrbitalStation_Core_[0-9]+</pattern>
        <offset>(0,0,0)</offset>
        <randomRotated>true</randomRotated>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Edge_[0-9]+</pattern>
        <offset>(0,0,1)</offset>
        <rotationOffset>0</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Edge_[0-9]+</pattern>
        <offset>(1,0,0)</offset>
        <rotationOffset>1</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Edge_[0-9]+</pattern>
        <offset>(0,0,-1)</offset>
        <rotationOffset>2</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Edge_[0-9]+</pattern>
        <offset>(-1,0,0)</offset>
        <rotationOffset>3</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Corner_[0-9]+</pattern>
        <offset>(-1,0,1)</offset>
        <rotationOffset>0</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Corner_[0-9]+</pattern>
        <offset>(1,0,1)</offset>
        <rotationOffset>1</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Corner_[0-9]+</pattern>
        <offset>(1,0,-1)</offset>
        <rotationOffset>2</rotationOffset>
      </li>
      <li>
        <pattern>TradingGuild_OrbitalStation_Corner_[0-9]+</pattern>
        <offset>(-1,0,-1)</offset>
        <rotationOffset>3</rotationOffset>
      </li>
    </structureLayouts>
  </VEF.Storyteller.StructureSetDef>
</Defs>
