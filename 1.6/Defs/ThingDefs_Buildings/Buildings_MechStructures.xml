<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="VGE_MechTurretBase">
        <defName>VGE_MechanoidChargeBattery</defName>
        <label>charge battery</label>
        <description>A massive, pulse-charged artillery battery for indiscriminate, wide-area saturation. It’s capable of firing long, inaccurate bursts of fast-moving explosive projectiles. The weapon is fully autonomous, operated by a machine brain that requires no crew. Commonly seen on orbital bombardment platforms.</description>
        <uiIconPath>Things/Mechanoid/MechanoidChargeBattery/MechanoidChargeBattery_MenuIcon</uiIconPath>
        <thingClass>VanillaGravshipExpanded.Building_EnemyMechTurret</thingClass>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Structures/Artillery/MechanoidOrbitalArtillery_Base_Normal</texPath>
            <drawSize>(5,5)</drawSize>
        </graphicData>
        <statBases>
            <MaxHitPoints>1400</MaxHitPoints>
            <Flammability>0</Flammability>
            <Beauty>-40</Beauty>
        </statBases>
        <size>(5,5)</size>
        <fillPercent>1</fillPercent>
        <passability>Impassable</passability>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <building>
            <turretGunDef>VGE_Gun_MechanoidChargeBattery</turretGunDef>
            <turretBurstCooldownTime>60</turretBurstCooldownTime>
            <turretTopDrawSize>7</turretTopDrawSize>
            <turretTopOffset>(0, 0.5)</turretTopOffset>
            <playTargetAcquiredSound>false</playTargetAcquiredSound>
            <combatPower>150</combatPower>
            <turretBurstWarmupTime>7.416</turretBurstWarmupTime>
        </building>
        <modExtensions>
            <li Class="VanillaGravshipExpanded.TurretExtension_RotationSpeed">
                <rotationSpeed>25</rotationSpeed>
            </li>
        </modExtensions>
        <comps>
            <li Class="VanillaGravshipExpanded.CompProperties_WorldArtillery">
                <worldMapAttackRange>36</worldMapAttackRange>
                <firingMode>GroundToSpace, SpaceToGround, SpaceToSpace, GroundToGround</firingMode>
            </li>
            <li Class="CompProperties_CanBeDormant">
                <compClass>CompMechanoid</compClass>
                <startsDormant>true</startsDormant>
            </li>
        </comps>
        <killedLeavings>
            <GravlitePanel>30</GravlitePanel>
            <ChunkSlagSteel>5</ChunkSlagSteel>
            <li MayRequire="Ludeon.RimWorld.Biotech">SubcoreHigh</li>
        </killedLeavings>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>VGE_Gun_MechanoidChargeBattery</defName>
        <label>charge battery</label>
        <description>A massive, pulse-charged artillery battery.</description>
        <graphicData>
            <texPath>Things/Mechanoid/MechanoidChargeBattery/MechanoidChargeBattery_TurretTop</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <verbs>
            <li>
                <verbClass>VanillaGravshipExpanded.Verb_ShootWithSmoke</verbClass>
                <defaultProjectile>VGE_Bullet_ChargeBattery</defaultProjectile>
                <range>500</range>
                <minRange>19</minRange>
                <burstShotCount>12</burstShotCount>
                <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>14</muzzleFlashScale>
                <forcedMissRadius>12</forcedMissRadius>
                <requireLineOfSight>false</requireLineOfSight>
                <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
                <isMortar>true</isMortar>
                <soundCast>VGE_GravshipChargeBlaster</soundCast>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
    </ThingDef>

