        <fillPercent>0.5</fillPercent>
        <pathCost>42</pathCost>
        <rotatable>false</rotatable>
        <destroyable>false</destroyable>
    </ThingDef>

    <ThingDef ParentName="VGE_MechStructureBase">
        <defName>VGE_MechanoidStabilizer</defName>
        <label>mechanoid stabilizer</label>
        <description>A compact astrofuel thruster built by the mechanoid core to propel their orbital platforms. Its construction mirrors human design but is reinforced with mechanical precision, lined with thick vacstone plating that shrugs off extreme heat and stress. These smaller thrusters assist platforms with fine-tuned maneuvering and position-holding in orbit. While unusable for human gravships, destroying one will yield a tiny supply of precious vacstone blocks.</description>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Mechanoid/MechanoidStabilizerThruster/MechanoidStabilizerThruster</texPath>
            <drawSize>(2,3)</drawSize>
        </graphicData>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>0</Flammability>
            <Beauty>-8</Beauty>
        </statBases>
        <size>(1,2)</size>
        <passability>PassThroughOnly</passability>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <fillPercent>0.4</fillPercent>
        <pathCost>20</pathCost>
        <rotatable>true</rotatable>
        <killedLeavings>
            <Steel>20</Steel>
            <BlocksVacstone>10</BlocksVacstone>
        </killedLeavings>
    </ThingDef>

    <ThingDef ParentName="VGE_MechStructureBase">
        <defName>VGE_MechanoidHeatsink</defName>
        <label>mechanoid heatsink</label>
        <description>A long, skeletal thermal regulator strut, built into the structure of mechanoid platforms to ensure total thermal stability. It absorbs waste heat from active mechanoid systems and converts a fraction of it into operational power, thus preventing core overheating and maintaining maximum efficiency.</description>
