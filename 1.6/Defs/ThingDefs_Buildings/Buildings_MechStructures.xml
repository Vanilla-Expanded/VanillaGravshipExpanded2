    <ThingDef ParentName="VGE_MechStructureBase">
        <defName>VGE_MechanoidGravTether</defName>
        <label>mechanoid grav tether</label>
        <description>A vast, artificial core of colossal mechanoid orbital platforms. Unlike human-built grav engines, these are constructed by the mechanoid core itself, optimized for ruthless efficiency and unending operation. They generate monumental lift and stabilization fields that allow entire, sprawling space stations to remain suspended in orbit, forming the backbone of mechanoid dominance in space. While largely incompatible with human systems, they can be destroyed to yield a gravcore, a rare and valuable prize for any who dare to challenge them.</description>
        <uiIconPath>Things/Mechanoid/MechanoidLargeGravEngine/MechanoidLargeGravEngine_MenuIcon</uiIconPath>
        <thingClass>VanillaGravshipExpanded2.Building_MechanoidGravTether</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Mechanoid/MechanoidLargeGravEngine/MechanoidLargeGravEngine</texPath>
            <drawSize>(5,5)</drawSize>
            <addTopAltitudeBias>true</addTopAltitudeBias>
        </graphicData>
        <statBases>
            <MaxHitPoints>3000</MaxHitPoints>
            <Flammability>0</Flammability>
            <Beauty>0</Beauty>
        </statBases>
        <size>(5,5)</size>
        <passability>PassThroughOnly</passability>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <fillPercent>0.6</fillPercent>
        <pathCost>20</pathCost>
        <rotatable>false</rotatable>
        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>16</glowRadius>
                <glowColor>(255, 40, 40, 0)</glowColor>
            </li>
        </comps>
        <killedLeavings>
            <Gravcore>1</Gravcore>
            <GravlitePanel>80</GravlitePanel>
            <ComponentSpacer>8</ComponentSpacer>
            <Plasteel>80</Plasteel>
        </killedLeavings>
    </ThingDef>

    <ThingDef ParentName="VGE_MechStructureBase">
        <defName>VGE_MechanoidHullPlatform</defName>
        <label>mechanoid hull platform</label>
        <description>A dense, structural building block used to form mechanoid orbital platforms. Due to the special gravlite alloys used to create them, they are impervious to damage. They are a constant fixture on mechanoid orbital platforms.</description>
