<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="VGE_GravshipArtillerySmallBase">
        <defName>VGE_AstrofireLauncher</defName>
        <label>astrofire launcher</label>
        <description>A compact multi-tube missile platform that shoots a volley of four rapid missiles that explode and carry a payload of astrofuel, setting the area hit on astrofire. Meant for fast, hard-hitting strikes against exposed gravships and unarmored surface forces. Requires a linked targeting terminal with an operator to function. It draws power directly from the grav engine.</description>
        <thingClass>VanillaGravshipExpanded.Building_JavelinPod</thingClass>
        <uiIconPath>Things/Structures/Combat/GravshipTurrets/AstrofireLauncher_MenuIcon</uiIconPath>
        <graphicData>
            <texPath>Things/Structures/Artillery/GravshipArtillery_Base_Small</texPath>
            <drawSize>(3,3)</drawSize>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>400</MaxHitPoints>
            <Flammability>0.4</Flammability>
            <WorkToBuild>18000</WorkToBuild>
            <Beauty>-25</Beauty>
			<Mass>60</Mass>
        </statBases>
        <size>(3,3)</size>
        <costList>
            <Steel>200</Steel>
            <GravlitePanel>60</GravlitePanel>
            <VGE_Astrofuel>120</VGE_Astrofuel>
            <ComponentIndustrial>8</ComponentIndustrial>
        </costList>
 	    <researchPrerequisites Inherit="False"/>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <building>
            <turretGunDef>VGE_Gun_AstrofireLauncher</turretGunDef>
            <turretBurstCooldownTime>24</turretBurstCooldownTime>
            <turretTopDrawSize>4</turretTopDrawSize>
            <turretTopOffset>(0, 0.25)</turretTopOffset>
            <turretBurstWarmupTime>6</turretBurstWarmupTime>
            <ai_combatDangerous>true</ai_combatDangerous>
            <relatedBuildCommands>
                <li>VGE_TargetingTerminal</li>
                <li>VGE_TargetingConsole</li>
            </relatedBuildCommands>
        </building>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Astrofuel</fuelLabel>
                <fuelGizmoLabel>Astrofuel</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>VGE_Astrofuel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>120</fuelCapacity>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <showFuelGizmo>true</showFuelGizmo>
                <initialFuelPercent>1</initialFuelPercent>
                <outOfFuelMessage>Missing rockets</outOfFuelMessage>
            </li>
            <li Class="VanillaGravshipExpanded.CompProperties_WorldArtillery">
                <worldMapAttackRange>20</worldMapAttackRange>
                <firingMode>GroundToSpace, GroundToGround, SpaceToSpace, SpaceToGround</firingMode>
            </li>
        </comps>
        <modExtensions>
            <li Class="VanillaGravshipExpanded.TurretExtension_RotationSpeed">
                <rotationSpeed>100</rotationSpeed>
            </li>
            <li Class="VanillaGravshipExpanded.TurretExtension_Barrels">
                <barrels>
                    <li>(0.5, 0, 1.5)</li>
					<li>(-0.5, 0, 1.5)</li>
                </barrels>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>PlaceWorker_TurretTop</li>
        </placeWorkers>
   		<genericMarketSellable>false</genericMarketSellable>
   		<designationCategory Inherit="False" />
   		<thingCategories>
     		<li>BuildingsMisc</li>
   		</thingCategories>
   		<minifiedDef>MinifiedThing</minifiedDef>
		<tradeTags>
			<li>GravshipUpgrade</li>
		</tradeTags>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>VGE_Gun_AstrofireLauncher</defName>
        <label>astrofire launcher</label>
        <description>A compact multi-tube missile platform capable of launching astrofire missiles.</description>
        <graphicData>
            <texPath>Things/Structures/Combat/GravshipTurrets/AstrofireLauncher_TurretTop</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <building>
            <turretTopLoadedGraphic>
                <texPath>Things/Structures/Combat/GravshipTurrets/AstrofireLauncher_TurretTop_Loaded</texPath>
                <graphicClass>Graphic_Single</graphicClass>
            </turretTopLoadedGraphic>
        </building>
        <verbs>
            <li>
                <verbClass>VanillaGravshipExpanded.Verb_ShootWithWorldTargeting</verbClass>
                <defaultProjectile>VGE_Rocket_AstrofireMissile</defaultProjectile>
                <range>99999</range>
                <minRange>14</minRange>
                <burstShotCount>4</burstShotCount>
                <ticksBetweenBurstShots>25</ticksBetweenBurstShots>
                <soundCast>VGE_JavelinLauncher_Cast</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>8</muzzleFlashScale>
                <forcedMissRadius>11.9</forcedMissRadius>
                <requireLineOfSight>false</requireLineOfSight>
                <consumeFuelPerShot>30</consumeFuelPerShot>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>VGE_Rocket_AstrofireMissile</defName>
        <label>Astrofire rocket</label>
        <graphicData>
            <texPath>Things/Projectile/Rocket_AstrofireLauncher</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <thingClass>VanillaGravshipExpanded.Projectile_JavelinRocket</thingClass>
        <projectile>
            <damageDef>VGE_AstrofireDamage</damageDef>
            <damageAmountBase>14</damageAmountBase>
      		<preExplosionSpawnThingDef>VGE_Filth_Astrofuel</preExplosionSpawnThingDef>
     		<preExplosionSpawnChance>0.15</preExplosionSpawnChance>
            <armorPenetrationBase>0.1</armorPenetrationBase>
            <speed>120</speed>
            <explosionRadius>4.9</explosionRadius>
            <flyOverhead>true</flyOverhead>
            <stoppingPower>0.5</stoppingPower>
            <soundImpact>BulletImpact_Metal</soundImpact>
            <soundExplode>MortarBomb_Explode</soundExplode>
            <soundAmbient>MortarRound_Ambient</soundAmbient>
        </projectile>
        <modExtensions>
            <li Class="VanillaGravshipExpanded.ThrusterProjectileExtension">
                <flameSize>3</flameSize>
                <flameShaderType>MoteGlow</flameShaderType>
                <flameShaderParameters>
                    <_MainTex>/Things/Mote/Exhaust/SmallHighPowerThruster_Burn</_MainTex>
                </flameShaderParameters>
                <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef>
                <emissionsPerSecond>40</emissionsPerSecond>
                <spawnRadiusRange>0.0~0.5</spawnRadiusRange>
                <velocity>(0.0,0.0,-20.0)</velocity>
                <velocityRotationRange>-10.0~10</velocityRotationRange>
                <velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
                <rotationOverTimeRange>-180.0~180</rotationOverTimeRange>
                <scaleRange>1.5~3</scaleRange>
            </li>
            <li Class="VanillaGravshipExpanded.SubstructureDamageExtension">
                <substructureDamageRadius>1.9</substructureDamageRadius>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>VGE_GravlaunchCloaker</defName>
        <label>gravlaunch cloaker</label>
        <description>A specialized device that masks the energy signature of a gravship launch, reducing the impact the gravship launch has on other inhabitants of the planet, making it less likely that the gravship will be detected.\n\nA gravship can support two gravlaunch cloakers.</description>
        <graphicData>
            <texPath>Things/Structures/Misc/GravlaunchCloaker/GravlaunchCloaker</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToBuild>6000</WorkToBuild>
            <Mass>50</Mass>
            <Flammability>0.6</Flammability>
            <Beauty>-5</Beauty>
        </statBases>
        <size>(2,2)</size>
        <rotatable>true</rotatable>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.6</fillPercent>
        <pathCost>20</pathCost>
        <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
        <costList>
            <Steel>50</Steel>
            <GravlitePanel>60</GravlitePanel>
            <ComponentIndustrial>6</ComponentIndustrial>
            <ComponentSpacer>4</ComponentSpacer>
        </costList>
        <comps>
            <li Class="CompProperties_GravshipFacility">
                <requiresLOS>false</requiresLOS>
                <maxSimultaneous>2</maxSimultaneous>
                <maxDistance>500</maxDistance>
                <statOffsets>
                    <VGE_GravshipVisibilityFactor>-0.15</VGE_GravshipVisibilityFactor>
                </statOffsets>
            </li>
        </comps>
        <tradeTags>
            <li>GravshipUpgrade</li>
        </tradeTags>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
        <minifiedDef>MinifiedThing</minifiedDef>
        <modExtensions>
            <li Class="VanillaGravshipExpanded2.WreckedBuildingReplacementExtension">
                <replacementBuilding>VGE_DestroyedGravlunchCloaker</replacementBuilding>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>VGE_Warcomputer</defName>
        <label>warcomputer</label>
        <description>The tactical supercomputer core of a gravship. It enhances the weapons and defenses of the gravship: it makes gauss artillery more accurate, javelin missiles fire faster, anticraft beam weaponry fire longer bursts, and point defense turrets intercept projectiles at greater distances. It draws power directly from the grav engine.</description>
        <graphicData>
            <texPath>Things/Structures/Misc/Warcomputer</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(4,4)</drawSize>
        </graphicData>
        <statBases>
            <MaxHitPoints>800</MaxHitPoints>
            <Mass>80</Mass>
            <Flammability>0.6</Flammability>
            <Beauty>-5</Beauty>
        </statBases>
        <size>(3,3)</size>
        <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.6</fillPercent>
        <pathCost>20</pathCost>
        <rotatable>false</rotatable>
        <costList>
            <Gravcore>1</Gravcore>
            <GravlitePanel>60</GravlitePanel>
            <ComponentSpacer>4</ComponentSpacer>
            <Steel>90</Steel>
        </costList>
        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>4</glowRadius>
                <glowColor>(0, 218, 255, 0)</glowColor>
            </li>
            <li Class="CompProperties_GravshipFacility">
                <requiresLOS>false</requiresLOS>
                <maxSimultaneous>1</maxSimultaneous>
                <maxDistance>500</maxDistance>
            </li>
        </comps>
        <tradeTags>
            <li>GravshipUpgrade</li>
        </tradeTags>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
        <minifiedDef>MinifiedThing</minifiedDef>
    </ThingDef>

    <ThingDef ParentName="BuildingBase">
        <defName>VGE_GravFieldDilutor</defName>
        <label>grav field dilutor</label>
        <description>An advanced ultratech device that dramatically increases the size of a gravship but makes the gravity field slightly weaker, resulting in a decrease to the amount of substructure that can be built. Must be built near a grav engine.\n\nA gravship can support only one grav field dilutor.</description>
        <graphicData>
            <texPath>Things/Structures/Misc/GravfieldDilutor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
        </graphicData>
        <statBases>
            <MaxHitPoints>800</MaxHitPoints>
            <Mass>65</Mass>
            <Flammability>0</Flammability>
            <Beauty>0</Beauty>
        </statBases>
        <size>(5,5)</size>
        <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.4</fillPercent>
        <pathCost>14</pathCost>
        <rotatable>false</rotatable>
        <costList>
            <Gravcore>1</Gravcore>
            <GravlitePanel>100</GravlitePanel>
            <ComponentSpacer>6</ComponentSpacer>
            <Steel>200</Steel>
        </costList>
        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>9</glowRadius>
                <glowColor>(0, 218, 255, 0)</glowColor>
            </li>
            <li Class="CompProperties_SubstructureFootprint">
                <radius>36.9</radius>
            </li>
            <li Class="CompProperties_GravshipFacility">
                <requiresLOS>false</requiresLOS>
                <maxSimultaneous>1</maxSimultaneous>
                <maxDistance>36.9</maxDistance>
                <statOffsets>
                    <SubstructureSupport>-250</SubstructureSupport>
                </statOffsets>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_InRangeOfGravEngine</li>
        </placeWorkers>
        <tradeTags>
            <li>GravshipUpgrade</li>
        </tradeTags>
        <thingCategories>
            <li>BuildingsMisc</li>
        </thingCategories>
        <minifiedDef>MinifiedThing</minifiedDef>
    </ThingDef>
</Defs>
