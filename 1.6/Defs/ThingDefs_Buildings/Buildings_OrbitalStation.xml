				<postExplosionSpawnThingDef>VGE_Filth_Astrofuel</postExplosionSpawnThingDef>
				<postExplosionSpawnChance>0.15</postExplosionSpawnChance>
				<wickTicks>480~480</wickTicks>
			</li>
		</comps>
	</ThingDef>
