		<graphicData>
			<texPath>Things/OrbitalStation/AstrofuelPipeSegment/AstrofuelPipeSegment</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,1)</drawSize>
		</graphicData>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<building>
			<paintable>false</paintable>
			<claimable>false</claimable>
			<neverBuildable>true</neverBuildable>
			<deconstructible>true</deconstructible>
		</building>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>7.9</explosiveRadius>
				<explosiveDamageType>VGE_AstrofireDamage</explosiveDamageType>
				<startWickOnDamageTaken>
					<li>Flame</li>
					<li>VGE_AstrofireDamage</li>
				</startWickOnDamageTaken>
