<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LowTechCrateBase" Name="VGE_OrbitalStationLowTechCrateBase" Abstract="True">
        <designationCategory>VGE_Designer</designationCategory>
  </ThingDef>
  
  <ThingDef ParentName="VGE_OrbitalStationLowTechCrateBase">
    <defName>VGE_SpacerPallet_Medicine</defName>
    <label>spacer medicine pallet</label>
    <description>A pallet containing medical supplies. Can be looted to yield medicine.</description>
    <size>(2, 2)</size>
    <fillPercent>0.3</fillPercent>
    <graphicData>
      <texPath>Things/OrbitalStation/Lootable/SpacerPallet_Medicine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
    </statBases>
	  <rotatable>false</rotatable>
    <comps>
      <li Class="CompProperties_EmptyStateGraphic">
        <graphicData>
          <texPath>Things/Building/Ancient/OpenableContainers/AirdropPallet_Open</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(2,2)</drawSize>
        </graphicData>
      </li>
      <li Class="CompProperties_LootSpawn">
        <contents>Reward_Pallet_Medicine</contents>
      </li>
    </comps>
  </ThingDef>
  
