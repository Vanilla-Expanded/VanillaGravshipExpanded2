<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="VGE_GravshipExpandedChapterTwoBuildingBase">
		<defName>VGE2_AstrofuelBarrel</defName>
		<label>astrofuel barrel</label>
		<description>A barrel of volatile astrofuel. It will explode if damaged.</description>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.5</fillPercent>
		<pathCost>50</pathCost>
		<size>(1,1)</size>
		<rotatable>false</rotatable>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<WorkToBuild>600</WorkToBuild>
		</statBases>
		<graphicData>
			<texPath>Things/OrbitalStation/AstrofuelBarrel</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<costList>
			<VGE_Astrofuel>10</VGE_Astrofuel>
		</costList>
		<resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<building>
			<paintable>false</paintable>
			<claimable>false</claimable>
			<neverBuildable>true</neverBuildable>
			<deconstructible>true</deconstructible>
		</building>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>5.9</explosiveRadius>
				<explosiveDamageType>VGE_AstrofireDamage</explosiveDamageType>
				<startWickOnDamageTaken>
					<li>Flame</li>
					<li>VGE_AstrofireDamage</li>
				</startWickOnDamageTaken>
				<damageAmountBase>10</damageAmountBase>
				<startWickHitPointsPercent>0.8</startWickHitPointsPercent>
				<postExplosionSpawnThingDef>VGE_Filth_Astrofuel</postExplosionSpawnThingDef>
				<postExplosionSpawnChance>0.15</postExplosionSpawnChance>
				<wickTicks>480~480</wickTicks>
			</li>
		</comps>
	</ThingDef>
	<ThingDef ParentName="VGE_GravshipExpandedChapterTwoBuildingBase">
		<defName>VGE2_AstrofuelPipeSegment</defName>
