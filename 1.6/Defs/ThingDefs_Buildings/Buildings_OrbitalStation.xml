    <ThingDef ParentName="VGE_EnemyPropBase">
        <defName>VGE_InfestedGravlockTether</defName>
        <label>infested gravlock tether</label>
        <description>A corrupted gravlock tether that has been hollowed out and repurposed into a gigantic exoinsectoid hive. Integrated directly into the station's ventilation system, this pulsing structure continuously pumps larvae through the vents, spawning new insectoids that spread throughout the station.\n\nDestroy the infested gravlock tether to obtain a gravcore.</description>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Insectoids/Structures/InfestedGravlockTether/InfestedGravlockTether</texPath>
            <drawSize>(6,6)</drawSize>
            <addTopAltitudeBias>true</addTopAltitudeBias>
        </graphicData>
        <statBases>
            <MaxHitPoints>4000</MaxHitPoints>
            <Mass>120</Mass>
            <Flammability>0.8</Flammability>
            <Beauty>-40</Beauty>
        </statBases>
        <size>(5,5)</size>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.6</fillPercent>
        <pathCost>20</pathCost>
        <rotatable>false</rotatable>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<building>
     		<deconstructible>false</deconstructible>
     		<repairable>false</repairable>
     		<claimable>false</claimable>
			<displayAttackToDestroyOnInspectPane>true</displayAttackToDestroyOnInspectPane>
		</building>
        <costList>
            <Gravcore>1</Gravcore>
            <GravlitePanel>100</GravlitePanel>
            <ComponentSpacer>6</ComponentSpacer>
            <InsectJelly>150</InsectJelly>
        </costList>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="VanillaGravshipExpanded2.CompProperties_InfestedGravlockTether" />
            <li Class="CompProperties_Glower">
                <glowRadius>7</glowRadius>
                <glowColor>(255, 40, 40, 0)</glowColor>
            </li>
    	  <li Class="CompProperties_InspectString">
     		   <inspectString>Contains: Gravcore</inspectString>
    	  </li>
            <li Class="CompProperties_LetterOnRevealed">
                <label>Infested gravlock tether</label>
                <text>You detect the heavy signs of the exoinsectoid mega-hive nearby. The infested gravlock tether must be destroyed to yield valuable gravcore and stop the ongoing infestation.</text>
                <letterDef>NeutralEvent</letterDef>
            </li>
        </comps>
    </ThingDef>

