      <li Class="CompProperties_LootSpawn">
        <contents>Reward_SpacerBox_Gravlite</contents>
      </li>
    </comps>
  </ThingDef>

    <ThingSetMakerDef>
    <defName>Reward_SpacerBox_Gravlite</defName>
    <root Class="ThingSetMaker_RandomOption">
      <options>

        <!-- Gravlite -->
        <li>
          <weight>1</weight>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>GravlitePanel</li>
                </thingDefs>
              </filter>
              <countRange>16~40</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>

      </options>
    </root>
  </ThingSetMakerDef>

</Defs>