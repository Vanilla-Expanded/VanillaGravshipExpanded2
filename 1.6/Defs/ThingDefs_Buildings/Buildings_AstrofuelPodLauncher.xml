<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>VGE_AstrofuelPodLauncher</defName>
    <label>astrofuel pod launcher</label>
    <description>A compact fueling port for launching one transport pod. Utilizing highly efficient astrofuel, this launcher is significantly smaller than traditional designs. Pod launchers can launch as a group - but the launchers must be placed adjacent to each other.</description>
    <thingClass>Building_PodLauncher</thingClass>
    <graphicData>
      <texPath>Things/Structures/Misc/AstrofuelPodLauncher/AstrofuelPodLauncher</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <drawerType>MapMeshAndRealTime</drawerType>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1.0</fillPercent>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2200</uiOrder>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <building>
      <hasFuelingPort>true</hasFuelingPort>
    </building>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <GravlitePanel>30</GravlitePanel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>150.0</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>150</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>VGE_Astrofuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelMultiplier>2</fuelMultiplier>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <drawFuelGaugeInMap>true</drawFuelGaugeInMap>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_FuelingPort</li>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <researchPrerequisites>
      <li>VGE_AdvancedOrbitalTech</li>
      <li>TransportPod</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiIconScale>0.9</uiIconScale>
    <modExtensions>
      <li Class="VEF.Buildings.RefuelableExtension">
        <ejectingFuelRespectsFuelMultiplier>true</ejectingFuelRespectsFuelMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>