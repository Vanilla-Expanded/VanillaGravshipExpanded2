<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="VGE_GravshipExpandedChapterTwoBuildingBase">
		<defName>VGE_TwistedSteel</defName>
		<label>twisted steel</label>
		<description>The collapsed remains of an ancient orbital vessel, bent and fused by countless years in the harsh vacuum. Rich in steel.</description>
		<passability>Impassable</passability>
		<thingClass>Mineable</thingClass>
		<fillPercent>1</fillPercent>
		<generateCommonality>0</generateCommonality>
		<uiIconPath>Things/Linked/TwistedJunk/TwistedMetal_MenuIcon</uiIconPath>
		<graphicData>
			<texPath>Things/Linked/TwistedJunk/TwistedMetal_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>CornerFiller</linkType>
			<linkFlags>
				<li>Wall</li>
				<li>Rock</li>
			</linkFlags>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
				<edgeTop>Damage/Edge</edgeTop>
				<edgeBot>Damage/Edge</edgeBot>
				<edgeLeft>Damage/Edge</edgeLeft>
				<edgeRight>Damage/Edge</edgeRight>
			</damageData>
		</graphicData>
		<statBases>
			<MaxHitPoints>2000</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>-1</Beauty>
		</statBases>
		<building>
			<mineableThing>Steel</mineableThing>
			<mineableYield>60</mineableYield>
			<mineableDropChance>1</mineableDropChance>
			<mineableYieldWasteable>false</mineableYieldWasteable>
			<isInert>true</isInert>
		</building>
		<staticSunShadowHeight>1.0</staticSunShadowHeight>
		<blockLight>true</blockLight>
		<category>Building</category>
		<mineable>true</mineable>
		<selectable>true</selectable>
		<drawerType>MapMeshOnly</drawerType>
		<filthLeaving>Filth_MachineBits</filthLeaving>
		<scatterableOnMapGen>false</scatterableOnMapGen>
	</ThingDef>
