	<ThingDef ParentName="VGE_GravshipCompactTurretBase">
		<defName>VGE_GravshipMinigunTurret</defName>
		<label>gravship minigun turret</label>
		<description>A compact gravship-mounted heavy automatic turret. Its multi-barrel mechanism unleashes sustained fire at high speed, shredding lightly armored targets at mid-range. It may explode when damaged.</description>
		<uiIconPath>Things/Structures/Combat/GravshipTurrets/GravshipMinigunTurret_MenuIcon</uiIconPath>
		<costList>
			<Steel>175</Steel>
			<GravlitePanel>40</GravlitePanel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<researchPrerequisites>
			<li>MultibarrelWeapons</li>
			<li>VGE_AdvancedGravshipWeaponry</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>160</basePowerConsumption>
			</li>
			<li Class="CompProperties_Refuelable">
				<fuelLabel>Steel</fuelLabel>
				<fuelGizmoLabel>Steel</fuelGizmoLabel>
				<fuelFilter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</fuelFilter>
				<fuelCapacity>180</fuelCapacity>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<showFuelGizmo>true</showFuelGizmo>
				<initialFuelPercent>1</initialFuelPercent>
			</li>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>1.9</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<startWickOnDamageTaken>
					<li>Flame</li>
				</startWickOnDamageTaken>
				<wickTicks>120</wickTicks>
				<chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
			</li>
		</comps>
		<building>
			<turretGunDef>VGE_Gun_GravshipMinigun</turretGunDef>
			<turretBurstCooldownTime>6</turretBurstCooldownTime>
		</building>
		<tickerType>Normal</tickerType>
	</ThingDef>
