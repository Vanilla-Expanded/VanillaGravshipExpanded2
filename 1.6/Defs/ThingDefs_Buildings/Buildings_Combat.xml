<Defs>
	<ThingDef ParentName="VGE_GravshipBuildingBase">
		<defName>VGE_TargetingConsole</defName>
		<label>targeting console</label>
		<description>A large targeting console capable of managing up to three gravship artillery pieces. Requires a crew member to manually aim and fire the weapons. It draws power directly from the grav engine.</description>
		<thingClass>VanillaGravshipExpanded2.Building_TargetingConsole</thingClass>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Structures/Combat/TargetingConsole/TargetingConsole</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,2)</drawSize>
		</graphicData>
		<passability>PassThroughOnly</passability>
		<designationCategory>VGE_Combat</designationCategory>
		<pathCost>50</pathCost>
		<fillPercent>0.4</fillPercent>
		<blockWind>true</blockWind>
		<statBases>
			<MaxHitPoints>260</MaxHitPoints>
			<WorkToBuild>6000</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Beauty>-8</Beauty>
		</statBases>
		<size>(3,1)</size>
		<resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
		<costList>
			<GravlitePanel>45</GravlitePanel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<rotatable>true</rotatable>
		<researchPrerequisites>
			<li>VGE_AdvancedGravshipWeaponry</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Mannable">
				<compClass>VanillaGravshipExpanded.CompMannableWithFailReason</compClass>
				<manWorkType>Violent, Intellectual</manWorkType>
			</li>
		</comps>
		<uiOrder>2005</uiOrder>
		<modExtensions>
			<li Class="VanillaGravshipExpanded2.WreckedBuildingReplacementExtension">
				<replacementBuilding>VGE_DestroyedTargetingConsole</replacementBuilding>
			</li>
		</modExtensions>
	</ThingDef>
