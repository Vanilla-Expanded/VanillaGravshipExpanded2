<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <WorldObjectDef ParentName="GeneratedAsteroid">
        <defName>VGE_InfestedAsteroid</defName>
        <description>A vacstone asteroid that has been infested by insectoids. Inside, the creatures have collected debris and salvage from orbital wrecks. The infestation is strong, and any attempt to clear the asteroid will mean heavy resistance.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <label>infested asteroid</label>
        <expandingIconTexture>UI/MapIcons/VGE_InfestedAsteroid</expandingIconTexture>
        <mapGenerator>VGE_InfestedAsteroid</mapGenerator>
    </WorldObjectDef>

    <WorldObjectDef ParentName="SpaceSite">
        <defName>VGE_EmptySpace</defName>
        <label>empty space</label>
        <description>An empty space.</description>
        <canBePlayerHome>true</canBePlayerHome>
        <treatAsPlayerHome>true</treatAsPlayerHome>
        <worldObjectClass>VanillaGravshipExpanded2.EmptySpace</worldObjectClass>
        <canHaveMap>true</canHaveMap>
        <modExtensions>
            <li Class="VEF.Maps.WorldObjectExtension">
                <disableObjectSpawnDefs>true</disableObjectSpawnDefs>
            </li>
        </modExtensions>
    </WorldObjectDef>

    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_EmptySpace</defName>
        <label>empty space</label>
        <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
        <disableCallAid>true</disableCallAid>
        <genSteps>
            <li>VGE_EmptySpace</li>
        </genSteps>
    </MapGeneratorDef>

    <GenStepDef>
        <defName>VGE_EmptySpace</defName>
        <order>100</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_EmptySpace" />
    </GenStepDef>

    <WorldObjectDef>
        <defName>VGE_TravellingWarpod</defName>
        <label>warpod</label>
        <description>A warpod in flight.</description>
        <worldObjectClass>VanillaGravshipExpanded2.TravellingWarpod</worldObjectClass>
        <texture>Things/Structures/Combat/Warpods/Warpod_HighExplosive</texture>
        <useDynamicDrawer>true</useDynamicDrawer>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>Things/Structures/Combat/Warpods/Warpod_HighExplosive</expandingIconTexture>
        <expandingIconPriority>65</expandingIconPriority>
        <expandMore>true</expandMore>
        <fullyExpandedInSpace>true</fullyExpandedInSpace>
        <validLaunchTarget>false</validLaunchTarget>
    </WorldObjectDef>

    <GenStepDef>
        <defName>VGE_Warplatform</defName>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_Warplatform">
            <structureSetDef>VGE_WarplatformSet</structureSetDef>
        </genStep>
    </GenStepDef>

    <WorldObjectDef ParentName="SpaceBase">
        <defName>VGE_ActiveWarplatform</defName>
        <label>active warplatform</label>
        <description>An ancient, autonomous orbital platform currently bombarding your gravship. The platform is controlled by a hostile warcomputer that must be neutralized to stop the bombardment.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <worldObjectClass>VanillaGravshipExpanded2.MapParent_WarPlatform</worldObjectClass>
        <expandingIconTexture>UI/MapIcons/VGE_Warplatform</expandingIconTexture>
        <mapGenerator>VGE_ActiveWarplatform</mapGenerator>
    </WorldObjectDef>

    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_ActiveWarplatform</defName>
        <label>active warplatform</label>
        <genSteps>
            <li>VGE_Warplatform</li>
        </genSteps>
    </MapGeneratorDef>

    <GeneratedLocationDef>
        <defName>VGE_GravshipHusk</defName>
        <worldObjectDef>VGE_GravshipHusk</worldObjectDef>
        <layerDefs>
            <li>Orbit</li>
        </layerDefs>
    </GeneratedLocationDef>

    <WorldObjectDef ParentName="SpaceBase">
        <defName>VGE_GravshipHusk</defName>
        <label>gravship husk</label>
        <description>A derelict gravship husk, severely ravaged by countless years adrift in space. Its skeletal frame is all that remains, but its tough structure still holds fragments of twisted metals and components that can be salvaged.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <mapGenerator>VGE_GravshipHusk</mapGenerator>
        <expandingIconTexture>UI/MapIcons/VGE_GravshipHusk</expandingIconTexture>
        <overrideMapSize>(250,1,250)</overrideMapSize>
        <nameMaker>VGE_NamerWorldObject_GravshipHusk</nameMaker>
    </WorldObjectDef>

    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_GravshipHusk</defName>
        <label>gravship husk</label>
        <genSteps>
            <li>VGE_GravshipHusk</li>
        </genSteps>
    </MapGeneratorDef>
    <GenStepDef>
        <defName>VGE_GravshipHusk</defName>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_GravshipHusk">
            <structureSetDef>VGE_GravshipHuskSet</structureSetDef>
        </genStep>
    </GenStepDef>

    <RulePackDef>
        <defName>VGE_NamerWorldObject_GravshipHusk</defName>
        <include>
            <li>WorldFeatureNamerCommon</li>
        </include>
        <rulePack>
            <rulesStrings>
                <li>r_name->[prefix_adj] [prefix_noun]</li>
                <li>prefix_adj->ancient</li>
                <li>prefix_adj->derelict</li>
                <li>prefix_adj->abandoned</li>
                <li>prefix_adj->lost</li>
                <li>prefix_adj->ruined</li>
                <li>prefix_adj->broken</li>
                <li>prefix_adj->shattered</li>
                <li>prefix_noun->gravship</li>
                <li>prefix_noun->husk</li>
                <li>prefix_noun->wreckage</li>
                <li>prefix_noun->remnant</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <SitePartDef>
        <defName>VGE_VacstoneMeteor</defName>
        <label>vacstone meteor</label>
        <workerClass>SitePartWorker_PreciousLump</workerClass>
        <description>An impact site of a vacstone meteor.</description>
        <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
        <expandingIconTexture>UI/MapIcons/VGE_VacstoneMeteor</expandingIconTexture>
        <forceExitAndRemoveMapCountdownDurationDays>11</forceExitAndRemoveMapCountdownDurationDays>
        <mainPartAllThreatsLabel>Hostile activity detected.</mainPartAllThreatsLabel>
        <gravShipsCanLandOn>true</gravShipsCanLandOn>
        <tags>
            <li>VGE_VacstoneMeteor</li>
        </tags>
    </SitePartDef>

    <GenStepDef>
        <defName>VGE_VacstoneMeteor</defName>
        <linkWithSite>VGE_VacstoneMeteor</linkWithSite>
        <order>450</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_VacstoneMeteor">
            <nearMapCenter>true</nearMapCenter>
        </genStep>
    </GenStepDef>

    <WorldObjectDef ParentName="SpaceBase">
        <defName>VGE_DormantWarplatform</defName>
        <label>dormant warplatform</label>
        <description>A dormant, heavily armed satellite platform floating in orbit. Long-range scans detect an array of gauss bombards controlled by a central warcomputer. The defenses will activate and immediately engage any incoming ships upon arrival.\n\nBreaching the installation will require fighting through automated turrets and sentry drones, but destroying or hacking the warcomputer will disable the anti-ship bombards.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <mapGenerator>VGE_DormantWarplatform</mapGenerator>
        <expandingIconTexture>UI/MapIcons/VGE_DormantWarplatform</expandingIconTexture>
    </WorldObjectDef>

    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_DormantWarplatform</defName>
        <label>dormant warplatform</label>
        <genSteps>
            <li>VGE_Warplatform</li>
        </genSteps>
    </MapGeneratorDef>

    <WorldObjectDef ParentName="SpaceBase">
        <defName>VGE_DerelictGravship</defName>
        <label>derelict gravship</label>
        <description>An immense, derelict gravship drifting silently in the void. Its machinery is broken, and its hull is vented to vacuum, but the sheer size of the wreck means valuable salvage is everywhere.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <worldObjectClass>VanillaGravshipExpanded2.MapParent_DerelictGravship</worldObjectClass>
        <expandingIconTexture>UI/MapIcons/VGE_DerelictGravship</expandingIconTexture>
        <mapGenerator>VGE_DerelictGravship</mapGenerator>
    </WorldObjectDef>

    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_DerelictGravship</defName>
        <label>derelict gravship</label>
        <genSteps>
            <li>VGE_DerelictGravship</li>
        </genSteps>
    </MapGeneratorDef>

    <GenStepDef>
        <defName>VGE_DerelictGravship</defName>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_DerelictGravship">
            <structureSetDef>VGE_DerelictGravshipSet</structureSetDef>
        </genStep>
    </GenStepDef>

    <SitePartDef ParentName="SpaceGravcoreLocationBase">
        <defName>VGE_GravshipGraveyard</defName>
        <label>gravship graveyard</label>
        <description>A massive field of debris containing a gravcore.</description>
        <tags>
            <li>VGE_GravshipGraveyard</li>
        </tags>
    </SitePartDef>

    <GenStepDef>
        <defName>VGE_GravshipGraveyard</defName>
        <linkWithSite>VGE_GravshipGraveyard</linkWithSite>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_GravshipGraveyard">
            <structureSetDef>VGE_GravshipGraveyardSet</structureSetDef>
        </genStep>
    </GenStepDef>

    <SitePartDef ParentName="SpaceGravcoreLocationBase">
        <defName>VGE_InfestedInstallation</defName>
        <label>infested installation</label>
        <description>An abandoned orbital station infested with exoinsectoids, containing a gravcore.</description>
        <tags>
            <li>VGE_InfestedInstallation</li>
        </tags>
    </SitePartDef>

    <GenStepDef>
        <defName>VGE_InfestedInstallation</defName>
        <linkWithSite>VGE_InfestedInstallation</linkWithSite>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_InfestedInstallation">
            <structureSetDef>VGE_InfestedInstallationSet</structureSetDef>
        </genStep>
    </GenStepDef>

    <GenStepDef>
        <defName>VGE_SalvagerStation</defName>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_SalvagerStation">
            <structureSetDef>VGE_SalvagerStationSet</structureSetDef>
        </genStep>
    </GenStepDef>
    <WorldObjectDef ParentName="SpaceBase">
        <defName>VGE_ActiveSalvagerStation</defName>
        <label>active salvager station</label>
        <description>A heavily armed, salvager-owned orbital station currently bombarding your gravship. The station is equipped with numerous pieces of gravship artillery that need to be destroyed to stop the bombardment.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <worldObjectClass>VanillaGravshipExpanded2.MapParent_WarPlatform</worldObjectClass>
        <expandingIconTexture>UI/MapIcons/SalvagerStation</expandingIconTexture>
        <mapGenerator>VGE_ActiveSalvagerStation</mapGenerator>
    </WorldObjectDef>
    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_ActiveSalvagerStation</defName>
        <label>active salvager station</label>
        <genSteps>
            <li>VGE_SalvagerStation</li>
        </genSteps>
    </MapGeneratorDef>

    <GenStepDef>
        <defName>VGE_EnemyGravjumper</defName>
        <order>200</order>
        <genStep Class="VanillaGravshipExpanded2.GenStep_EnemyGravjumper">
        </genStep>
    </GenStepDef>

    <WorldObjectDef ParentName="SpaceBase">
        <defName>VGE_ActiveEnemyGravjumper</defName>
        <label>Enemy gravjumper</label>
        <description>An enemy gravjumper, which is a compact, short-range gravship that relies on the gravjumper engine and a pilot cockpit to operate. Offers minimal substructure support and footprint, making it ideal for scouting and exploration.\n\nThis location can be reached using transport pods, shuttles, or a gravship.</description>
        <worldObjectClass>VanillaGravshipExpanded2.MapParent_WarPlatform</worldObjectClass>
        <expandingIconTexture>UI/MapIcons/EnemyGravjumper</expandingIconTexture>
        <mapGenerator>VGE_ActiveEnemyGravjumper</mapGenerator>
    </WorldObjectDef>

    <MapGeneratorDef ParentName="SpaceMapGenerator">
        <defName>VGE_ActiveEnemyGravjumper</defName>
        <label>active enemy gravjumper</label>
        <genSteps>
            <li>VGE_EnemyGravjumper</li>
        </genSteps>
    </MapGeneratorDef>
</Defs>
