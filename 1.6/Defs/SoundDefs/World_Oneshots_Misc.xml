		<context>MapOnly</context>
		<subSounds>
			<li>
				<onCamera>true</onCamera>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Misc/InsectTurret/InsectTurret_LockOn</clipPath>
