<Defs>
	<!--  Exoleech -->
	<ThingDef ParentName="VGE_BaseInsect">
		<defName>VGE_Exoleech</defName>
		<label>exoleech</label>
		<description>Not actually a leech, an exoleech is a bioengineered insectoid roughly the size of a bear, adapted to survive the frigid vacuum of space. It possesses an incredibly sharp mouth capable of dealing substantial damage in combat. While heavily protected by thick chitinous armor and deadly at close quarters, It is quite slow in open terrain.</description>
		<statBases>
			<MoveSpeed>3</MoveSpeed>
			<Flammability>0.5</Flammability>
			<MarketValue>570</MarketValue>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.33</ArmorRating_Sharp>
			<Wildness>0.4</Wildness>
			<LeatherAmount>0</LeatherAmount>
		</statBases>
		<tools>
			<li>
				<label>bitejaw</label>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>16</power>
				<armorPenetration>0.2</armorPenetration>
				<cooldownTime>2.5</cooldownTime>
				<linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<armorPenetration>0.1</armorPenetration>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
		<race>
			<body>VGE_WormWithArmor</body>
			<baseHungerRate>0.38</baseHungerRate>
			<manhunterOnTameFailChance>0</manhunterOnTameFailChance>
