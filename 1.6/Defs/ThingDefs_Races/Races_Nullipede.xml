<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Nullipede -->
	<ThingDef ParentName="VGE_BaseInsect">
		<defName>VFEI2_Nullipede</defName>
		<label>nullipede</label>
		<description>An incredibly rare and monstrously large insectoid of the Exo geneline, the nullipede is an insect leviathan perfectly adapted to the frigid vacuum of space. It possesses extreme cellular regeneration, allowing it to knit together grievous wounds and heal damage almost instantly. Direct exposure to fire completely shuts down its biological repair systems. Its sheer resilience makes it a dreaded, virtually indestructible horror among the stars, and the main reason many adventurers prefer to stay planet-side.</description>
		<statBases>
			<MoveSpeed>3</MoveSpeed>
			<Flammability>0.7</Flammability>
			<MarketValue>1800</MarketValue>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.32</ArmorRating_Sharp>
			<LeatherAmount>0</LeatherAmount>
			<Wildness>0.8</Wildness>
		</statBases>
		<tools>
			<li>
				<label>mandible</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<armorPenetration>0.35</armorPenetration>
				<power>18</power>
				<cooldownTime>2.4</cooldownTime>
				<linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
			</li>
			<li>
				<label>tail</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<armorPenetration>0.15</armorPenetration>
				<power>14</power>
				<cooldownTime>1.4</cooldownTime>
				<chanceFactor>0.2</chanceFactor>
				<linkedBodyPartsGroup>VGE_TailAttackTool</linkedBodyPartsGroup>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>9.33</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
				<label>pincers</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>12</power>
				<armorPenetration>0.2</armorPenetration>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>9.33</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
		</tools>
		<comps>
			<li Class="VEF.AnimalBehaviours.CompProperties_Draftable">
				<makeNonFleeingToo>true</makeNonFleeingToo>
			</li>
			<li Class="VEF.AnimalBehaviours.CompProperties_InitialHediff">
				<hediffname>VFEI2_ExtremeRegeneration</hediffname>
				<hediffseverity>1</hediffseverity>
			</li>
			<li Class="VanillaGravshipExpanded2.CompProperties_ExtremeRegeneration">
				<rateInTicks>360</rateInTicks>
				<tendMin>0.2</tendMin>
				<tendMax>0.7</tendMax>
				<activeHediff>VFEI2_ExtremeRegeneration</activeHediff>
				<inactiveHediff>VFEI2_ExtremeRegeneration_Inactive</inactiveHediff>
			</li>
		</comps>
		<race>
			<body>VGE_WormWithArmorHeadClawAndTail</body>
			<baseHungerRate>0.05</baseHungerRate>
			<baseBodySize>4.8</baseBodySize>
			<baseHealthScale>5.5</baseHealthScale>
			<useMeatFrom>Megaspider</useMeatFrom>
			<manhunterOnDamageChance>1</manhunterOnDamageChance>
			<manhunterOnTameFailChance>1</manhunterOnTameFailChance>
			<trainability>Advanced</trainability>
			<lifeExpectancy>12</lifeExpectancy>
			<!--<leatherDef>VFEI2_Chitin</leatherDef>-->
			<lifeStageAges>
				<li>
					<def>EusocialInsectLarva</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>EusocialInsectJuvenile</def>
					<minAge>0.05</minAge>
				</li>
				<li>
					<def>EusocialInsectAdult</def>
					<minAge>1</minAge>
					<soundWounded>Pawn_BigInsect_Pain</soundWounded>
					<soundDeath>Pawn_BigInsect_Death</soundDeath>
					<soundCall>Pawn_BigInsect_Call</soundCall>
					<soundAngry>Pawn_BigInsect_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
		</race>
		<!--<killedLeavings>
			<VFEI2_PherocoreExo>1</VFEI2_PherocoreExo>
		</killedLeavings>-->
	</ThingDef>
