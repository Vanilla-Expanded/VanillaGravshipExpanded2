<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--  Exohive -->
	<ThingDef ParentName="VGE_BaseInsect">
		<defName>VGE_Exohive</defName>
		<label>moving exohive</label>
		<description>A massive, mobile hive of giant exo-geneline insects, propelled by the coordinated effort of numerous emerging exoworms. When sufficiently threatened, the entire structure animates to actively defend itself, attacking nearby foes.</description>
		<statBases>
			<MoveSpeed>2</MoveSpeed>
			<Flammability>0</Flammability>
			<MarketValue>750</MarketValue>
			<ArmorRating_Blunt>0.1</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.26</ArmorRating_Sharp>
			<Wildness>0.8</Wildness>
			<LeatherAmount>0</LeatherAmount>
			<MeatAmount>0</MeatAmount>
		</statBases>
		<tools>
			<li>
				<label>mouths</label>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>14</power>
				<armorPenetration>0.18</armorPenetration>
				<cooldownTime>2.1</cooldownTime>
				<linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
			</li>
			<li>
				<label>shell</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<armorPenetration>0.1</armorPenetration>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
		<comps>
			<li Class="VEF.AnimalBehaviours.CompProperties_Regeneration">
				<rateInTicks>360</rateInTicks>
				<healAmount>50</healAmount>
				<healOneTendOne>true</healOneTendOne>
				<healAll>false</healAll>
				<tendMin>0.6</tendMin>
				<tendMax>0.6</tendMax>
			</li>
		</comps>
		<race>
			<deathAction Class="VEF.AnimalBehaviours.DeathActionProperties_SpawnItemsAndFilth">
				<items>
					<InsectJelly>45</InsectJelly>
				</items>
				<filthCreated>Filth_Slime</filthCreated>
				<filthCountRange>5~10</filthCountRange>
				<sound>Hive_Spawn</sound>
			</deathAction>
			<body>VGE_WormHive</body>
			<baseHungerRate>0.04</baseHungerRate>
			<manhunterOnTameFailChance>1</manhunterOnTameFailChance>
			<manhunterOnDamageChance>1</manhunterOnDamageChance>
			<baseBodySize>3</baseBodySize>
			<baseHealthScale>5</baseHealthScale>
			<useMeatFrom>Megaspider</useMeatFrom>
			<lifeExpectancy>14</lifeExpectancy>
			<trainability>Advanced</trainability>
			<lifeStageAges>
				<li>
					<def>EusocialInsectLarva</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>EusocialInsectJuvenile</def>
					<minAge>0.05</minAge>
				</li>
				<li>
					<def>EusocialInsectAdult</def>
					<minAge>1</minAge>
					<soundWounded>Pawn_Megascarab_Wounded</soundWounded>
					<soundDeath>Pawn_Megascarab_Death</soundDeath>
					<soundCall>Pawn_Megascarab_Call</soundCall>
					<soundAngry>Pawn_Megascarab_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
		</race>
	</ThingDef>
	<PawnKindDef ParentName="InsectKindBase">
		<defName>VGE_Exohive</defName>
		<label>moving exohive</label>
		<race>VGE_Exohive</race>
		<combatPower>750</combatPower>
		<ecoSystemWeight>0.50</ecoSystemWeight>
		<aiAvoidCover>false</aiAvoidCover>
		<defendPointRadius>0</defendPointRadius>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<texPath>Things/Insectoids/MovingExoHive</texPath>
					<drawSize>1.6</drawSize>
				</bodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>Things/Insectoids/MovingExoHive</texPath>
					<drawSize>1.6</drawSize>
				</bodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>Things/Insectoids/MovingExoHive</texPath>
					<drawSize>1.6</drawSize>
					<shadowData>
						<volume>(0.5, 0.7, 0.43)</volume>
						<offset>(0,0,-0.1)</offset>
					</shadowData>
				</bodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>
</Defs>