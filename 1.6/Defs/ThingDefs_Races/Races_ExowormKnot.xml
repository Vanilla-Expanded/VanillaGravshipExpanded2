<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--  Exoworm knot -->
	<ThingDef ParentName="VGE_BaseInsect">
		<defName>VGE_ExowormKnot</defName>
		<label>exoworm knot</label>
		<description>A massive, writhing knot of bioengineered exoworms, tangled together in a singular, terrifying entity. Its formidable size and complex, interwoven bodies grant it extreme durability, but damage causes individual exoworms to violently rupture from the mass and continue the fight. Its bite carries a risk of implanting parasitic exoworm larvae, which gestate slowly within the host.</description>
		<statBases>
			<MoveSpeed>2.1</MoveSpeed>
			<Flammability>0.5</Flammability>
			<MarketValue>1150</MarketValue>
			<ArmorRating_Blunt>0.32</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.32</ArmorRating_Sharp>
			<FilthRate>2</FilthRate>
			<Wildness>0.2</Wildness>
			<LeatherAmount>0</LeatherAmount>
			<MeatAmount>0</MeatAmount>
		</statBases>
		<tools>
			<li>
				<label>mouths</label>
				<capacities>
					<li>VGE_ExowormInfestation</li>
				</capacities>
				<power>10</power>
				<armorPenetration>0.07</armorPenetration>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>4</power>
				<armorPenetration>0.06</armorPenetration>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<chanceFactor>0.1</chanceFactor>
			</li>
		</tools>
		<comps>
			<li Class="VEF.AnimalBehaviours.CompProperties_SpawnPawnsOnMissingBodyPart">
				<pawnKindOptions>
					<li>VGE_Exoworm</li>
				</pawnKindOptions>
				<filthCreated>Filth_BloodInsect</filthCreated>
				<filthCountRange>2~5</filthCountRange>
				<sound>Hive_Spawn</sound>
			</li>
			<li Class="VEF.AnimalBehaviours.CompProperties_InitialHediff">
				<hediffname>VGE_NoPain</hediffname>
				<hediffseverity>1</hediffseverity>
			</li>
		</comps>
		<race>
			<deathAction Class="VEF.AnimalBehaviours.DeathActionProperties_DivideAndCreateFilth">
				<dividePawnKindOptions>
					<li>VGE_Exoworm</li>
					<li>VGE_Exoworm</li>
					<li>VGE_Exoworm</li>
				</dividePawnKindOptions>
				<filthCreated>Filth_BloodInsect</filthCreated>
				<filthCountRange>5~10</filthCountRange>
				<sound>Hive_Spawn</sound>
			</deathAction>
			<body>VGE_WormKnot</body>
			<baseHungerRate>0.84</baseHungerRate>
			<manhunterOnTameFailChance>0</manhunterOnTameFailChance>
			<baseBodySize>4</baseBodySize>
			<baseHealthScale>8</baseHealthScale>
			<useMeatFrom>Megaspider</useMeatFrom>
			<lifeExpectancy>16</lifeExpectancy>
			<trainability>Intermediate</trainability>
			<lifeStageAges>
				<li>
					<def>EusocialInsectLarva</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>EusocialInsectJuvenile</def>
					<minAge>0.03</minAge>
				</li>
				<li>
					<def>EusocialInsectAdult</def>
					<minAge>0.4</minAge>
					<soundWounded>Pawn_Megascarab_Wounded</soundWounded>
					<soundDeath>Pawn_Megascarab_Death</soundDeath>
					<soundCall>Pawn_Megascarab_Call</soundCall>
					<soundAngry>Pawn_Megascarab_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
		</race>
	</ThingDef>
