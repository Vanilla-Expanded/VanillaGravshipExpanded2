<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<VanillaGravshipExpanded.LaunchBoonDef>
		<defName>VGE_CompletelyHidden</defName>
		<label>completely hidden</label>
		<letterLabel>completely hidden</letterLabel>
    <letterText>Through sheer luck, thick cloud cover, and the fact that anyone nearby just happened to be looking the other way, {GRAVSHIP} descended completely unobserved. The ship touched down without a single soul noticing it was ever in the sky.</letterText>
		<letterDef>PositiveEvent</letterDef>
		<workerClass>VanillaGravshipExpanded2.LaunchBoonWorker_Visibility</workerClass>
		<weight>1</weight>
    <modExtensions>
      <li Class="VanillaGravshipExpanded2.VisibilityLandingOutcomeExtension">
        <!-- <visibilityFactor> - a factor on the base visibility. -->
        <!-- <visibilityOffset> - an offsett added to the visibility gained by launch, unaffected by launchVisibilityFactor but affected by grav engine factors. -->
        <!-- <visibilityOffsetNoFactor> - an offset that is unaffected by anything else. -->
        <visibilityFactor>0</visibilityFactor>
      </li>
    </modExtensions>
	</VanillaGravshipExpanded.LaunchBoonDef>

</Defs>