<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="DropPodLeaving" Name="VGE_EscapePodLeaving">
    <defName>VGE_EscapePodLeaving</defName>
    <altitudeLayer>BelowTerrain</altitudeLayer>
    <graphicData>
      <!-- All terrains will have a renderQueue value in range of 2000 to 2400, so we need to use a value smaller than that. -->
      <!-- Technically, it could be lower than 2000 if a FloorDef uses a negative renderPrecedence value... but let's not worry about it. -->
      <renderQueue>1999</renderQueue>
    </graphicData>
    <skyfaller>
      <!-- Don't draw a shadow, since we drop the pod under the terrain. -->
      <shadow IsNull="True" />
      <angleCurve>
        <points>
          <!-- Normal skyfallers have -33.7 angle, so we add 180 degrees to it to make it point downwards instead, but slightly offset like vanilla. -->
          <li>(0,146.3)</li>
        </points>
      </angleCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>VGE_SalvagerDropshipIncoming</defName>
    <label>salvager dropship (incoming)</label>
    <thingClass>VanillaGravshipExpanded2.SalvagerDropshipIncoming</thingClass>
    <graphicData>
      <texPath>Things/OrbitalStation/SalvagerDropship/SalvagerDropship</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(7,7)</drawSize>
    </graphicData>
    <size>(3,5)</size>
    <skyfaller>
      <anticipationSound>Shuttle_Landing</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <minimalRoofDestruction>true</minimalRoofDestruction>
      <shadowSize>(3.5,5.5)</shadowSize>
      <zPositionCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.85,5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>VGE_SalvagerDropshipLeaving</defName>
    <label>salvager dropship (leaving)</label>
    <thingClass>VanillaGravshipExpanded2.SalvagerDropshipLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/OrbitalStation/SalvagerDropship/SalvagerDropship</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(7,7)</drawSize>
    </graphicData>
    <size>(3,5)</size>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>Shuttle_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-120~-120</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(3.5,5.5)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,5)</li>
          <li>(1,30)</li>
        </points>
      </zPositionCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>VGE_SalvagerDropshipBombardment</defName>
    <thingClass>VanillaGravshipExpanded2.Spawner_SalvagerDropshipBombardment</thingClass>
    <useHitPoints>false</useHitPoints>
    <tickerType>Normal</tickerType>
    <drawerType>None</drawerType>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>VGE_LandingStructure_StructureSet</defName>
    <label>landing structure</label>
    <thingClass>VanillaGravshipExpanded2.LandingStructure_StructureSet</thingClass>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>VGE_LandingStructure_EnemyGravjumper</defName>
    <label>landing structure</label>
    <thingClass>VanillaGravshipExpanded2.LandingStructure_StructureSet</thingClass>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
  </ThingDef>

  <ThingDef ParentName="EtherealThingBase">
    <defName>VGE_LandingStructure_EnemyGravjumperCaptured</defName>
    <label>landing structure</label>
    <thingClass>VanillaGravshipExpanded2.LandingStructure_EnemyStructure</thingClass>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
  </ThingDef>
</Defs>
