<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>VGE_Apparel_CombatVacsuit</defName>
    <label>combat vacsuit</label>
    <description>A heavy-duty suit of powered armor designed for combat in the vacuum of space. The multi-layered, reinforced plating offers superior protection against ballistic attacks compared to standard vacsuits. While neuro-memetic assistors partially mitigate the bulk, the suit still imposes a penalty on movement speed and manipulation, though less severe than the standard model.</description>
    <generateAllowChance>0</generateAllowChance>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Equipment/Vacarmor/Vacarmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>58000</WorkToMake>
      <MaxHitPoints>240</MaxHitPoints>
      <Mass>18</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.88</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.78</ArmorRating_Heat>
      <Insulation_Cold>90</Insulation_Cold>
      <Insulation_Heat>15</Insulation_Heat>
      <EquipDelay>14</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.5</MoveSpeed>
      <VacuumResistance>0.33</VacuumResistance>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>HiTechArmor</li>
      <li>Armor</li>
    </tradeTags>
    <smeltable>true</smeltable>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Equipment/Vacarmor/Vacarmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
<!--        <li>Vacsuit</li>-->
      </tags>
      <defaultOutfitTags>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
    <costList>
      <ComponentSpacer>3</ComponentSpacer>
      <Plasteel>90</Plasteel>
      <GravlitePanel>20</GravlitePanel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>VGE_AdvancedOrbitalTech</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <displayPriority>235</displayPriority>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>VGE_Apparel_CombatVacsuitHelmet</defName>
    <label>combat vacsuit helmet</label>
    <description>A heavy-duty, reinforced helmet for the combat vacsuit. It features layered plasteel-weave armor, a built-in status computer, and superior protection. Efficiently recycling oxygen, it permits extended vacuum operation, though periodic repressurization is required.</description>
    <possessionCount>1</possessionCount>
    <generateAllowChance>0</generateAllowChance>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Equipment/Vacarmor/VacarmorHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>15000</WorkToMake>
      <MaxHitPoints>160</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.88</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.78</ArmorRating_Heat>
      <Insulation_Cold>6</Insulation_Cold>
      <Insulation_Heat>4</Insulation_Heat>
      <EquipDelay>4</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
      <VacuumResistance>0.66</VacuumResistance>
    </equippedStatOffsets>
    <smeltable>true</smeltable>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Equipment/Vacarmor/VacarmorHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
<!--        <li>Vacsuit</li>-->
      </tags>
      <forceEyesVisibleForRotations>
        <li>1</li>
        <li>2</li>
        <li>3</li>
      </forceEyesVisibleForRotations>
      <defaultOutfitTags>
        <li>Spacefarer</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>HiTechArmor</li>
      <li>Armor</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
    <costList>
      <ComponentSpacer>1</ComponentSpacer>
      <Plasteel>20</Plasteel>
      <GravlitePanel>10</GravlitePanel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>VGE_AdvancedOrbitalTech</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <displayPriority>237</displayPriority>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

</Defs>
