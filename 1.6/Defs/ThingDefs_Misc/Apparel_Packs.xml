<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>VGE_Apparel_Astrorig</defName>
    <label>astrorig</label>
    <description>A specialized personal movement pack designed for rapid traversal in zero-gravity environments. Utilizing a contained oxygen supply for controlled thrust, it allows for long-distance, high-speed jumps in space. The pack's design eliminates movement penalties on space terrain, though the amount of long range jumps is limited by the oxygen supply.</description>
    <techLevel>Spacer</techLevel>
    <comps>
      <li Class="VanillaGravshipExpanded.CompProperties_ApparelOxygenProvider">
        <maxCharges>100</maxCharges>
        <percentageToAutoRefill>0.334</percentageToAutoRefill>
        <fuelDef>VGE_OxygenCanister</fuelDef>
        <fuelCountPerCharge>1</fuelCountPerCharge>
        <destroyOnEmpty>false</destroyOnEmpty>
        <chargeNoun>oxygen u³</chargeNoun>
        <minResistanceToActivate>0.12</minResistanceToActivate>
      </li>
      <li Class="VanillaGravshipExpanded2.CompProperties_ApparelVerbOwnerOxygen">
        <hotKey>Misc4</hotKey>
        <chargeNoun>jump</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <chargePerUse>10</chargePerUse>
        <cooldownTicks>3000</cooldownTicks>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>VanillaGravshipExpanded2.Verb_OxygenJump</verbClass>
        <label>jump</label>
        <violent>false</violent>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>True</onlyManualCast>
        <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
        <warmupTime>0.5</warmupTime>
        <warmupEffecter>VGE_AstrorigWarmupEffect</warmupEffecter>
        <requireLineOfSight>true</requireLineOfSight>
        <flightEffecterDef>VGE_AstrorigFlightEffect</flightEffecterDef>
        <soundLanding>VGE_AstrorigLand</soundLanding>
        <rangeStat>VGE_OxygenJumpRange</rangeStat>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
        <layerWhitelist>
          <li>Orbit</li>
        </layerWhitelist>
      </li>
    </verbs>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>VGE_AdvancedOrbitalTech</researchPrerequisite>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>320</displayPriority>
    </recipeMaker>
    <costList>
      <ComponentIndustrial>2</ComponentIndustrial>
      <GravlitePanel>20</GravlitePanel>
      <VGE_OxygenCanister>100</VGE_OxygenCanister>
    </costList>
    <graphicData>
      <texPath>Things/Equipment/Astrorig/Astrorig</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToMake>16000</WorkToMake>
      <Mass>4</Mass>
<!--      <Flammability>0.4</Flammability>-->
      <EquipDelay>2</EquipDelay>
      <VGE_OxygenJumpRange>32.9</VGE_OxygenJumpRange>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <generateAllowChance>0.15</generateAllowChance>
    <apparel>
      <wornGraphicPath>Things/Equipment/Astrorig/Astrorig</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.15)</offset>
        </north>
        <south>
          <offset>(0,0.1)</offset>
          <scale>(1.3,1)</scale><!--frame covered by pawn body unless we stretch-->
        </south>
        <east>
          <offset>(-0.35,-0.05)</offset>
          <thin>
            <offset>(0.05,0)</offset>
          </thin>
          <hulk>
            <offset>(-0.1,0)</offset>
          </hulk>
          <fat>
            <offset>(-0.15,0)</offset>
          </fat>
        </east>
        <west>
          <offset>(0.35,-0.05)</offset>
          <thin>
            <offset>(-0.05,0)</offset>
          </thin>
          <hulk>
            <offset>(0.1,0)</offset>
          </hulk>
          <fat>
            <offset>(0.15,0)</offset>
          </fat>
        </west>
        <male>
          <scale>(0.8,0.8)</scale>
        </male>
        <female>
          <scale>(0.75,0.75)</scale>
        </female>
        <thin>
          <scale>(0.7,0.7)</scale>
        </thin>
        <hulk>
          <scale>(1.2,1.2)</scale>
        </hulk>
        <fat>
          <scale>(1.1,1.1)</scale>
        </fat>
      </wornGraphicData>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
<!--      <tags>-->
<!--        <li>BeltDefensePop</li>-->
<!--      </tags>-->
    </apparel>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
    <modExtensions>
      <li Class="VEF.Apparels.ApparelExtension">
        <moveSpeedFactorByTerrainTag>
          <li>
            <key>Space</key>
            <value>
              <li>
                <moveSpeedFactor>27.5</moveSpeedFactor>
              </li>
            </value>
          </li>
        </moveSpeedFactorByTerrainTag>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>VGE_Apparel_DisposableOxygenPack</defName>
    <label>disposable oxygen pack</label>
    <description>A single-use utility pack containing a supply of compressed oxygen. When worn with vacuum-sealed apparel, it provides full immunity to vacuum by supplying breathable air until depleted. Once spent or unequipped, the seal is compromised and the pack is destroyed.</description>
    <thingClass>VanillaGravshipExpanded2.Apparel_DisposableOxygenPack</thingClass>
    <techLevel>Industrial</techLevel>
    <smeltable>False</smeltable>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <comps>
      <li Class="VanillaGravshipExpanded.CompProperties_ApparelOxygenProvider">
        <maxCharges>10</maxCharges>
        <percentageToAutoRefill>0</percentageToAutoRefill>
        <destroyOnEmpty>true</destroyOnEmpty>
        <chargeNoun>oxygen u³</chargeNoun>
        <minResistanceToActivate>0.12</minResistanceToActivate>
      </li>
    </comps>
    <graphicData>
      <texPath>Things/Equipment/DisposableOxygenPack/DisposableOxygenPack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <Mass>3</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <generateAllowChance>0</generateAllowChance>
    <apparel>
      <wornGraphicPath>Things/Equipment/DisposableOxygenPack/DisposableOxygenPack</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.15)</offset>
        </north>
        <south>
          <offset>(0,0.1)</offset>
          <scale>(1.3,1)</scale>
        </south>
        <east>
          <offset>(-0.35,-0.05)</offset>
          <thin>
            <offset>(0.05,0)</offset>
