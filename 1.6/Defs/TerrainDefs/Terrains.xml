<Defs>
    <TerrainDef ParentName="FloorBase">
        <defName>VGE_GravshipSubarmor</defName>
        <label>gravship subarmor</label>
        <description>A reinforced structural layer with flooring on top that forms the deck of a gravship. Built from dense grav-hardened alloys, this subarmor is completely indestructible, shielding the vessel from artillery impact and crash landing damage. Only things on top of this substructure can be lifted by the grav engine's levitation field. This floor must be constructed within range of a grav engine.</description>
        <texturePath>Terrain/Subarmor</texturePath>
        <uiIconPath>Terrain/Subarmor_MenuIcon</uiIconPath>
        <fertility>0</fertility>
        <edgeType>Fade</edgeType>
        <renderPrecedence>399</renderPrecedence>
        <constructEffect>ConstructMetal</constructEffect>
        <isPaintable>true</isPaintable>
        <designationCategory>VGE_Platform</designationCategory>
        <uiOrder>1002</uiOrder>
        <isFoundation>true</isFoundation>
        <terrainAffordanceNeeded>Walkable</terrainAffordanceNeeded>
        <preventCraters>true</preventCraters>
        <affordances>
            <li>Substructure</li>
            <li>VGE_SubstructureAndOrbitalPlatform</li>
        </affordances>
        <statBases>
            <WorkToBuild>1800</WorkToBuild>
            <Flammability>0</Flammability>
            <CleaningTimeFactor>0.9</CleaningTimeFactor>
            <Beauty>0</Beauty>
            <MarketValue>30</MarketValue>
        </statBases>
        <costList>
            <GravlitePanel>5</GravlitePanel>
            <Plasteel>1</Plasteel>
        </costList>
        <researchPrerequisites>
            <li>VGE_GravshipDefenses</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_InSubstructureFootprint</li>
            <li>PlaceWorker_BuildingsValidOverSubstructure</li>
        </placeWorkers>
        <tags>
            <li>Substructure</li>
            <li>VGE_Subarmor</li>
        </tags>
    </TerrainDef>

    <TerrainDef ParentName="NaturalTerrainBase">
        <defName>VGE_AncientSubstructure</defName>
        <label>ancient substructure</label>
        <description>A foundation of an orbital vessel, now twisted and warped. Doesn't seem to offer anything of value.</description>
        <texturePath>Terrain/AncientSubstructureTerrain</texturePath>
        <uiIconPath>Terrain/AncientSubstructure_MenuIcon</uiIconPath>
        <fertility>0</fertility>
        <pathCost>3</pathCost>
        <edgeType>Hard</edgeType>
        <renderPrecedence>399</renderPrecedence>
        <designationCategory>VGE_Designer</designationCategory>
        <isFoundation>true</isFoundation>
        <layerable>true</layerable>
        <affordances Inherit="false">
            <li>Walkable</li>
            <li>Light</li>
            <li>Medium</li>
            <li>Heavy</li>
        </affordances>
        <statBases>
            <CleaningTimeFactor>0.9</CleaningTimeFactor>
        </statBases>
        <tags>
            <li>VGE_AncientSubstructure</li>
            <li>DestroyableByArtillery</li>
        </tags>
        <spaceEdgeGraphicData Inherit="False">
            <OShapeTexPath>Terrain/AncientSubstructureBorder/AncientSubstructureBorder_OShape</OShapeTexPath>
            <UShapeTexPath>Terrain/AncientSubstructureBorder/AncientSubstructureBorder_UShape</UShapeTexPath>
            <CornerInnerTexPath>Terrain/AncientSubstructureBorder/AncientSubstructureBorder_CornerInner</CornerInnerTexPath>
            <CornerOuterTexPath>Terrain/AncientSubstructureBorder/AncientSubstructureBorder_CornerOuter</CornerOuterTexPath>
            <FlatTexPath>Terrain/AncientSubstructureBorder/AncientSubstructureBorder_Flat</FlatTexPath>
            <LoopLeftTexPath>Terrain/AncientSubstructureProps/AncientSubstructureProps_Right</LoopLeftTexPath>
            <LoopRightTexPath>Terrain/AncientSubstructureProps/AncientSubstructureProps_Right</LoopRightTexPath>
            <LoopSingleTexPath>Terrain/AncientSubstructureProps/AncientSubstructureProps_Right</LoopSingleTexPath>
            <LoopTexPaths>
                <li>Terrain/AncientSubstructureProps/AncientSubstructureProps_Loops</li>
            </LoopTexPaths>
        </spaceEdgeGraphicData>
        <modExtensions>
            <li Class="VanillaGravshipExpanded.SubstructureEdgeGraphicsExtension" />
        </modExtensions>
    </TerrainDef>

    <TerrainDef ParentName="FloorBase">
        <defName>VGE_Subcreep</defName>
        <label>subcreep</label>
        <description>An insectoid-made lightweight sponge-goop structure with creep on top that forms the surface of an exohive. Only things on top of this substructure can be lifted by the grav engine's levitation field. This floor must be constructed within range of a grav engine. Supports insectoid structures and significantly hinders non-insectoid movement.</description>
        <texturePath>Terrain/Subcreep</texturePath>
        <uiIconPath>Terrain/Subcreep_MenuIcon</uiIconPath>
        <edgeType>FadeRough</edgeType>
        <renderPrecedence>70</renderPrecedence>
        <isPaintable>false</isPaintable>
        <pathCost>46</pathCost>
        <statBases>
            <Beauty>0</Beauty>
            <Cleanliness>-2</Cleanliness>
            <FilthMultiplier>1.5</FilthMultiplier>
            <WorkToBuild>1000</WorkToBuild>
            <CleaningTimeFactor>0.5</CleaningTimeFactor>
            <Flammability>0</Flammability>
            <MarketValue>14</MarketValue>
            <Mass>1</Mass>
        </statBases>
        <isFoundation>true</isFoundation>
        <terrainAffordanceNeeded IsNull="True"></terrainAffordanceNeeded>
        <affordances Inherit="false">
            <li MayRequire="OskarPotocki.VFE.Insectoid2">VFEI2_Creep</li>
            <li>Walkable</li>
        </affordances>
        <fertility>0</fertility>
        <uiOrder>2020</uiOrder>
        <designationCategory>VGE_Designer</designationCategory>
        <tags>
            <li>VFEI2_Creep</li>
            <li>DestroyableByArtillery</li>
            <li>VGE_Subcreep</li>
        </tags>
        <spaceEdgeGraphicData>
            <OShapeTexPath>Terrain/SubcreepBorder/SubcreepBorder_OShape</OShapeTexPath>
            <UShapeTexPath>Terrain/SubcreepBorder/SubcreepBorder_UShape</UShapeTexPath>
            <CornerInnerTexPath>Terrain/SubcreepBorder/SubcreepBorder_CornerInner</CornerInnerTexPath>
            <CornerOuterTexPath>Terrain/SubcreepBorder/SubcreepBorder_CornerOuter</CornerOuterTexPath>
            <FlatTexPath>Terrain/SubcreepBorder/SubcreepBorder_Flat</FlatTexPath>
            <LoopLeftTexPath>Terrain/SubcreepBorder/SubcreepProps_Right</LoopLeftTexPath>
            <LoopRightTexPath>Terrain/SubcreepBorder/SubcreepProps_Right</LoopRightTexPath>
            <LoopSingleTexPath>Terrain/SubcreepBorder/SubcreepProps_Right</LoopSingleTexPath>
            <LoopTexPaths>
                <li>Terrain/SubcreepBorder/SubcreepProps_Loops</li>
            </LoopTexPaths>
        </spaceEdgeGraphicData>
        <modExtensions>
            <li Class="VanillaGravshipExpanded.SubstructureEdgeGraphicsExtension" />
        </modExtensions>
    </TerrainDef>

    <TerrainDef ParentName="PlatformBase">
        <defName>VGE_EnemySubstructure</defName>
        <label>enemy substructure</label>
        <description>A lightweight truss structure with flooring on top that forms the deck of an enemy gravship. Cannot be claimed or used by anyone but the enemy crew. Can be deconstructed to yield some resources.</description>
        <texturePath>Terrain/EnemySubstructure</texturePath>
        <uiIconPath>Terrain/EnemySubstructure_MenuIcon</uiIconPath>
        <fertility>0</fertility>
        <edgeType>Hard</edgeType>
        <renderPrecedence>399</renderPrecedence>
        <isFoundation>true</isFoundation>
        <layerable>true</layerable>
        <affordances Inherit="false">
            <li>Walkable</li>
            <li>Light</li>
            <li>Medium</li>
            <li>Heavy</li>
            <li>Substructure</li>
            <li>VGE_SubstructureAndOrbitalPlatform</li>
        </affordances>
        <statBases>
            <CleaningTimeFactor>0.9</CleaningTimeFactor>
            <MarketValue>14</MarketValue>
            <Mass>1</Mass>
            <Beauty>0</Beauty>
            <Flammability>0</Flammability>
            <FilthMultiplier>1</FilthMultiplier>
        </statBases>
        <costList>
            <Steel>2</Steel>
        </costList>
        <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
        <designationCategory>VGE_Designer</designationCategory>
        <modExtensions>
            <li Class="VanillaGravshipExpanded.SubstructureEdgeGraphicsExtension">
                <renderAsSubstructure>True</renderAsSubstructure>
            </li>
            <li Class="VanillaGravshipExpanded.DamagedTerrainReplacementExtension">
                <damagedTerrain>VGE_EnemyDamagedSubstructure</damagedTerrain>
            </li>
        </modExtensions>
    </TerrainDef>

